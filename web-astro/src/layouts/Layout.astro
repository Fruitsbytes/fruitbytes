---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import MainHeader from '../components/shell/MainHeader';
import MainFooter from '../components/shell/MainFooter';
import RightPanel from '../components/shell/RightPanel';
import BackgroundActivity from '../components/shell/BackgroundActivity';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'FruitsBytes — developer portfolio of Jeffrey N. Carre' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// Material Symbols icon names used across the app — keep in sync with web-stencil/src/index.html
const ICON_NAMES_ROUNDED = 'arrow_selector_tool,block,check,chevron_right,close,content_copy,dark_mode,devices,home,light_mode,logout,menu,more_vert,ramen_dining,settings,volume_off,volume_up';
const ICON_NAMES_SHARP = 'account_balance,arrow_back,arrow_forward,article,book,business_center,category,chat,check_circle,close,code,description,design_services,developer_board,download,email,error,info,install_mobile,ios_share,label,language,link,location_on,mail,music_note,nature,offline_bolt,person,phone_iphone,schedule,school,send,smartphone,space_dashboard,speed,sports_esports,subject,theaters,view_in_ar,wifi,workspace_premium';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Fonts — match Stencil */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&family=Roboto+Mono:wght@400;500&display=swap`}
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=${ICON_NAMES_ROUNDED}`}
    />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=${ICON_NAMES_SHARP}`}
    />

    {/* Set theme before hydration to avoid flash */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersLight ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (_e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="bg-[var(--body-bg)] text-[var(--body-text)] font-[Roboto_Flex] transition-colors">
    {/*
      Architecture (per user direction 2026-05-03):
        - RIGHT PANEL hosts the main content (slotted Astro page content).
        - LEFT SIDE is reserved for ambient/secondary content shown when
          screen is wide (3D scene, decorative widgets — added later).
      Persistent islands keep state across navigations.
    */}
    <BackgroundActivity client:visible transition:persist />
    <MainHeader client:load transition:persist />

    {/*
      RightPanel is intentionally NOT transition:persist — the slot content
      (page-specific) needs to swap on navigation, and persist would
      preserve the entire subtree including the old slot. Module-scoped
      Solid signals (logs, menuWidth, theme) survive remounts because the
      JS module stays loaded across View Transitions.
    */}
    <RightPanel client:load>
      <main id="main-content" role="main" aria-label="Main content">
        <slot />
      </main>
    </RightPanel>

    <MainFooter client:load transition:persist />
  </body>
</html>
