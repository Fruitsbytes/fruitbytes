---
// PORT: web-stencil/src/components/gui-contact/gui-contact.tsx
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/contact/ContactForm.tsx';
---

<Layout title="Contact — FruitsBytes">
  {/*
    @container makes responsive breakpoints react to the right panel's
    width, not the viewport. Two-column layout kicks in when the panel
    is ≥ 768px (@3xl). Below that the form stacks below the info section.
  */}
  <div class="@container max-w-[1200px] mx-auto px-4 sm:px-6 py-8 sm:py-12 animate-fade-in-up">

    <header class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8 pb-3 sm:pb-4 border-b border-[var(--panel-border)]">
      <span class="material-symbols-sharp text-[32px] sm:text-[40px] text-[#0078d7]">mail</span>
      <h1 class="text-2xl sm:text-3xl font-normal m-0 text-[var(--panel-text-strong)]">Contact</h1>
    </header>

    <div class="grid gap-8 @3xl:gap-12 @3xl:grid-cols-[1fr_1.5fr]">

      <section class="contact-info">
        <h2 class="text-lg sm:text-xl font-medium mb-2 sm:mb-3 text-[var(--panel-text-strong)]">Get in touch</h2>
        <p class="leading-relaxed text-[var(--panel-text)] mb-4 sm:mb-6 text-sm sm:text-base">
          Have a project in mind, a question, or just want to say hi? Drop a note and I'll reply.
        </p>

        <div class="flex flex-col gap-3 sm:gap-5">
          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-all hover:bg-[var(--panel-toolbar)]">
            <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">email</span>
            <div class="flex-1 min-w-0">
              <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Email</strong>
              <a href="mailto:jeffrey.carre@anbapyezanman.com" class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline break-all transition-colors">
                jeffrey.carre@anbapyezanman.com
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-all hover:bg-[var(--panel-toolbar)]">
            <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">location_on</span>
            <div class="flex-1 min-w-0">
              <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Location</strong>
              <span class="text-xs sm:text-sm text-[var(--panel-text)]">Montréal, QC, Canada</span>
            </div>
          </div>

          <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-all hover:bg-[var(--panel-toolbar)]">
            <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">link</span>
            <div class="flex-1 min-w-0">
              <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Social</strong>
              <div class="flex flex-wrap items-center gap-2">
                <a href="https://github.com/fruitsbytes" target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline">GitHub</a>
                <span class="text-[var(--panel-divider)]">•</span>
                <a href="https://linkedin.com/in/jeffrey-carre" target="_blank" rel="noopener noreferrer" class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline">LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded p-4 sm:p-6 @lg:p-8">
        <ContactForm client:load />
      </section>

    </div>
  </div>
</Layout>
