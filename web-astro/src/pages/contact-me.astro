---
// PORT TARGET: web-stencil/src/components/gui-contact/gui-contact.tsx
// The interactive form lives in the right panel (DevTools-style inspector
// — see ContactInspector.tsx). The left main area shows contact info and
// alternative ways to reach me.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — FruitsBytes">
  <div class="@container max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12 animate-fade-in-up">

    <header class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8 pb-3 sm:pb-4 border-b border-[var(--panel-border)]">
      <span class="material-symbols-sharp text-[32px] sm:text-[40px] text-[#0078d7]">mail</span>
      <h1 class="text-2xl sm:text-3xl font-normal m-0 text-[var(--panel-text-strong)]">Contact</h1>
    </header>

    <p class="text-base text-[var(--panel-text)] mb-6 max-w-prose leading-relaxed">
      Use the message form in the panel on the right. Or, if you prefer:
    </p>

    <div class="flex flex-col gap-3 sm:gap-4">
      <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-colors hover:bg-[var(--panel-toolbar)]">
        <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">email</span>
        <div class="flex-1 min-w-0">
          <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Email</strong>
          <a
            href="mailto:jeffrey.carre@anbapyezanman.com"
            class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline break-all transition-colors"
          >
            jeffrey.carre@anbapyezanman.com
          </a>
        </div>
      </div>

      <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-colors hover:bg-[var(--panel-toolbar)]">
        <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">location_on</span>
        <div class="flex-1 min-w-0">
          <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Location</strong>
          <span class="text-xs sm:text-sm text-[var(--panel-text)]">Montréal, QC, Canada</span>
        </div>
      </div>

      <div class="flex items-start gap-3 sm:gap-4 p-3 sm:p-4 bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded transition-colors hover:bg-[var(--panel-toolbar)]">
        <span class="material-symbols-sharp text-[20px] sm:text-[24px] text-[#0078d7] mt-0.5">link</span>
        <div class="flex-1 min-w-0">
          <strong class="block text-xs sm:text-sm font-medium mb-1 text-[var(--panel-text-strong)]">Social</strong>
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="https://github.com/Fruitsbytes"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline"
            >
              GitHub
            </a>
            <span class="text-[var(--panel-divider)]">•</span>
            <a
              href="https://www.linkedin.com/in/jeffrey-nicholson-carre/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs sm:text-sm text-[#0078d7] hover:text-[#1e90ff] hover:underline"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>

    <p class="text-xs text-[var(--panel-text)] mt-8 opacity-70 italic">
      Tip: messages submitted via the right-panel form post to web3forms and arrive at my inbox; you'll see a confirmation entry appear in the Console tab.
    </p>

  </div>
</Layout>
