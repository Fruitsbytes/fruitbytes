---
// PORT TARGET: web-stencil/src/components/gui-projects/gui-projects.tsx
import Layout from '../layouts/Layout.astro';
import {
  PROJECTS,
  CATEGORY_BADGE_CLASSES,
  CATEGORY_ICONS,
} from '../data/projects';
---

<Layout title="Projects — FruitsBytes">
  <div class="@container max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 animate-fade-in-up">

    <header class="text-center mb-8 sm:mb-12">
      <h1 class="text-3xl @lg:text-5xl font-bold mb-3 bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
        {/* TODO: i18n projectsPage.title */}
        Projects &amp; Portfolio
      </h1>
      <p class="text-base @lg:text-xl text-[var(--panel-text)]">
        {/* TODO: i18n projectsPage.subtitle */}
        Web applications, mobile apps, 3D graphics, fintech platforms, and wireless network solutions.
      </p>
    </header>

    <div class="grid grid-cols-1 @3xl:grid-cols-2 gap-4 sm:gap-6">
      {PROJECTS.map((project) => (
        <article class="bg-[var(--panel-bg)] border border-[var(--panel-border)] rounded-lg overflow-hidden hover:border-[#5a5d61] transition-colors">

          <div class="p-4 sm:p-6 border-b border-[var(--panel-border)]">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-medium border ${CATEGORY_BADGE_CLASSES[project.category]}`}>
                <span class="material-symbols-sharp text-[14px]">{CATEGORY_ICONS[project.category]}</span>
                {project.category.toUpperCase()}
              </span>
              <span class="text-xs text-[var(--panel-text)]">{project.year}</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold mt-3 mb-0 text-blue-300">{project.title}</h2>
          </div>

          <div class="p-4 sm:p-6 space-y-4">
            <p class="text-sm text-[var(--panel-text-strong)] leading-relaxed m-0">
              {project.description}
            </p>

            <div>
              <h3 class="text-xs font-semibold text-green-400 mb-2 uppercase tracking-wider">
                {/* TODO: i18n projectsPage.keyHighlights */}
                Key highlights
              </h3>
              <ul class="list-disc list-inside text-xs sm:text-sm text-[var(--panel-text-strong)] space-y-1 m-0">
                {project.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold text-green-400 mb-2 uppercase tracking-wider">
                {/* TODO: i18n projectsPage.technologies */}
                Technologies
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {project.technologies.map((tech) => (
                  <span class="px-2 py-0.5 text-[11px] bg-[var(--panel-toolbar)] border border-[var(--panel-border)] rounded text-[var(--panel-text)]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm text-blue-400 hover:text-blue-300 hover:underline mt-2"
              >
                {/* TODO: i18n projectsPage.viewProject */}
                <span>View project</span>
                <span class="material-symbols-sharp text-[16px]">arrow_forward</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <div class="inline-block bg-[var(--panel-bg)] border border-blue-400/40 rounded-lg p-5 sm:p-6 max-w-lg">
        <h3 class="text-xl sm:text-2xl font-bold mb-2 text-blue-300">
          {/* TODO: i18n projectsPage.cta.title */}
          Got a project in mind?
        </h3>
        <p class="text-sm text-[var(--panel-text-strong)] mb-4">
          {/* TODO: i18n projectsPage.cta.subtitle */}
          Let's talk about what you'd like to build.
        </p>
        <a
          href="/contact-me"
          class="inline-block bg-[#0078d7] hover:bg-[#1e90ff] text-white font-medium px-5 py-2.5 rounded-lg transition-colors text-sm"
        >
          {/* TODO: i18n projectsPage.cta.button */}
          Get in touch
        </a>
      </div>
    </div>

  </div>
</Layout>
